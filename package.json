{
  "name": "minikit-room",
  "packageManager": "yarn@4.9.1",
  "private": true,
  "workspaces": [
    "apps/frontend",
    "scripts/labyrinthine-cosmetic-scraper",
    "packages/shared"
  ],
  "scripts": {
    "dev:frontend": "yarn workspace @mkr/frontend start",
    "task:scrap-labyrinthine": "EXPORT_PATH=apps/frontend/public/assets/labyrinthine yarn workspace @mkr/labyrinthine-cosmetic-scraper start",
    "build:prod": "yarn run task:scrap-labyrinthine && yarn workspace @mkr/frontend build"
  }
}
